{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "^(mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__create_and_submit_pull_request_review|mcp__github__submit_pending_pull_request_review|Bash)$",
          "hooks": [
            {
              "type": "command",
              "command": "python3.12 \"${ZCODE_PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-.}}/.zcode/hooks/check_pr_title.py\"",
              "shell": "bash",
              "timeoutMs": 10000,
              "statusMessage": "校验 PR 标题正文与评审结果（提交前门禁）"
            }
          ]
        }
      ]
    }
  }
}
