#!/usr/bin/env bash
# pre-commit hook：提交前的静态检查 —— 格式化 + Clippy + 硬编码密钥扫描。
#
# 不跑 test：测试由 CI 的三平台矩阵负责，本地提交不必等编译测试。
# 需要本地全量验证时手动跑 `just check`（fmt + clippy + test）。
#
# commit message 规范也不在这里校验：git 跑 pre-commit 时还没把消息写进
# COMMIT_EDITMSG（编辑器 / -m / -F 都一样），在这里读到的只会是上一条提交的
# 消息，既可能误拦也可能放过。消息规范由 CI 的 commitlint job 覆盖
# （PR / push 会校验本次引入的全部 message）。
set -euo pipefail

# 定位项目根目录（hook 可能从任何子目录触发）
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v just >/dev/null 2>&1; then
  echo "✗ 未找到 just，无法运行提交前检查" >&2
  echo "  安装：brew install just" >&2
  exit 1
fi

# fmt/clippy 只关心 Rust，有 .rs 变更时才跑（全量经 just precommit）；密钥扫描
# 语言无关，任何提交都跑——否则往文档/脚本里塞一个真 key 就能静默绕过本地
# 这道闸（CI 的 quality job 另有兜底，但密钥越晚发现吊销成本越高）。
STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -z "$STAGED" ]; then
  echo "→ pre-commit: 无变更，跳过检查"
  exit 0
fi

STAGED_RS="$(printf '%s\n' "$STAGED" | grep '\.rs$' || true)"
if [ -z "$STAGED_RS" ]; then
  echo "→ pre-commit: 无 .rs 变更，跳过 fmt/clippy，仅跑密钥扫描..."
  if ! just secrets; then
    echo "" >&2
    echo "✗ 检出疑似硬编码密钥，已阻止提交" >&2
    echo "  误报用行尾 secrets:allow 放行（规则见 scripts/check-secrets.sh）" >&2
    exit 1
  fi
  exit 0
fi

echo "→ pre-commit: 运行静态检查（just precommit = fmt + clippy + secrets）..."
if ! just precommit; then
  echo "" >&2
  echo "✗ 静态检查未通过，已阻止提交" >&2
  echo "  格式问题用 'just fmt-fix' 自动修复；修好再提交，别用 --no-verify 绕过" >&2
  exit 1
fi
