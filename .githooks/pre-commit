#!/usr/bin/env python3
# 提交前钩子：提交前的静态检查，含格式化、静态检查（Clippy）与硬编码密钥扫描等，
# 全套清单见配方清单里的提交前检查配方。
# 需要本地全量验证时手动运行根配方的全量检查配方（格式化、静态检查与测试）。

import os
import shutil
import subprocess
import sys


def run_recipe(recipe):
    return subprocess.run(["just", recipe]).returncode


def reject(message, hint):
    print("", file=sys.stderr)
    print(message, file=sys.stderr)
    print(hint, file=sys.stderr)
    return 1


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if root.returncode != 0:
        print("✗ 不在 git 仓库内，无法运行提交前检查", file=sys.stderr)
        return 1
    # 定位项目根目录（钩子可能从任何子目录触发）
    os.chdir(root.stdout.strip())

    cargo_bin = os.path.expanduser("~/.cargo/bin")
    os.environ["PATH"] = cargo_bin + os.pathsep + os.environ.get("PATH", "")

    if not shutil.which("just"):
        print("✗ 未找到 just，无法运行提交前检查", file=sys.stderr)
        print("  安装：brew install just", file=sys.stderr)
        return 1

    staged = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    ).stdout.split()
    if not staged:
        print("→ pre-commit: 无变更，跳过检查")
        return 0

    # 有本语言（Rust）源码变更才跑格式化与静态检查（全量经提交前检查配方）；密钥扫描、
    # 指令文档引用校验与约束检查语言无关，任何提交都跑。
    if not any(f.endswith(".rs") for f in staged):
        print("→ pre-commit: 无 .rs 变更，跳过 fmt/clippy，跑密钥扫描 / 文档引用 / 约束检查...")
        gates = [
            ("secrets", "✗ 检出疑似硬编码密钥，已阻止提交",
             "  误报用行尾 secrets:allow 放行（规则见 scripts/hooks/check_secrets.py）"),
            ("agents-doc", "✗ AGENTS.md 描述了不存在的配方/路径，已阻止提交（见上）", ""),
            ("test-bdd", "✗ bdd.md 与测试源码不一致，已阻止提交（见上）", ""),
            ("constraints", "✗ 违反「不可协商的约束」，已阻止提交（见上）", ""),
            ("i18n", "✗ 违反「界面文案统一进文案表」，已阻止提交（见上）", ""),
        ]
        for recipe, message, hint in gates:
            if run_recipe(recipe) != 0:
                return reject(message, hint)
        return 0

    print("→ pre-commit: 运行静态检查（just precommit 全套：约束 + 文档引用 + BDD 清单 "
          "+ 文案表 + 注释纪律 + fmt + clippy + secrets）...")
    if run_recipe("precommit") != 0:
        return reject("✗ 静态检查未通过，已阻止提交",
                      "  格式问题用 'just fmt-fix' 自动修复；修好再提交，别用 --no-verify 绕过")
    return 0


if __name__ == "__main__":
    sys.exit(main())
