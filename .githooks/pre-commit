#!/usr/bin/env bash
# pre-commit hook：提交前唯一门禁（原 commit-msg 与 pre-push 的检查已合并至此）
#   1) commit message 规范（Conventional Commits）
#   2) Rust 质量门禁：fmt + clippy + test
# cargo 命令统一经 just 调用，保证与 CI 用的是同一套命令。
set -euo pipefail

# 定位项目根目录（hook 可能从任何子目录触发）
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v just >/dev/null 2>&1; then
  echo "✗ 未找到 just，无法运行提交门禁" >&2
  echo "  安装：brew install just" >&2
  exit 1
fi

GIT_DIR="$(git rev-parse --git-dir)"

# ---- 1. commit message 规范 ----
# merge commit 的消息由 git 自动生成，不算作者手写内容，跳过校验
# 依赖 git 在 pre-commit 之前写好 COMMIT_EDITMSG：实测 git 2.24 可行、2.15 用
# `-m` / `-F -` 提交时该文件仍是上一条消息；这类老版本留下的空档由 CI 的
# commitlint job 兜底（PR / push 都会校验本次引入的所有 message）。
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo "→ pre-commit: merge commit，跳过 commit message 校验"
elif [ -f "$GIT_DIR/COMMIT_EDITMSG" ]; then
  echo "→ pre-commit: 校验 commit message..."
  just lint-commit "$GIT_DIR/COMMIT_EDITMSG" || exit 1
else
  echo "  警告: 未找到 commit message 文件，跳过校验"
fi

# ---- 2. Rust 质量门禁（只在有 .rs 变更时需要）----
STAGED_RS="$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)"
if [ -z "$STAGED_RS" ]; then
  echo "  无 .rs 文件变更，跳过 Rust 门禁"
  exit 0
fi

echo "→ pre-commit: 运行 Rust 门禁（just check = fmt + clippy + test）..."
if ! just check; then
  echo "" >&2
  echo "✗ 质量门禁未通过，已阻止提交" >&2
  echo "  格式问题用 'just fmt-fix' 自动修复；修好再提交，别用 --no-verify 绕过" >&2
  exit 1
fi
