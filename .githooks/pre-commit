#!/usr/bin/env python3
"""提交前钩子：按暂存面派生门禁组合——暂存含本语言（Rust）源码、构建清单或
工具链清单变更时视为编译型变更，走提交前门禁配方；其余（脚本、文档、配置）
走纯文本门禁配方。组合清单由配方层单点维护，本钩子只做选择、不手抄清单。
"""

import os
import shutil
import subprocess
import sys

COMPILE_SUFFIXES = (".rs",)
COMPILE_MANIFESTS = ("Cargo.toml", "rust-toolchain.toml")


def run_recipe(recipe):
    return subprocess.run(["just", recipe]).returncode


def reject(message, hint):
    print("", file=sys.stderr)
    print(message, file=sys.stderr)
    print(hint, file=sys.stderr)
    return 1


def needs_compile_gates(staged):
    return any(
        f.endswith(COMPILE_SUFFIXES) or os.path.basename(f) in COMPILE_MANIFESTS
        for f in staged
    )


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if root.returncode != 0:
        print("✗ not inside a git repository; cannot run pre-commit checks", file=sys.stderr)
        return 1
    os.chdir(root.stdout.strip())

    cargo_bin = os.path.expanduser("~/.cargo/bin")
    os.environ["PATH"] = cargo_bin + os.pathsep + os.environ.get("PATH", "")

    if not shutil.which("just"):
        print("✗ just not found; cannot run pre-commit checks", file=sys.stderr)
        print("  install: brew install just", file=sys.stderr)
        return 1

    staged = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    ).stdout.split()
    if not staged:
        print("→ pre-commit: no staged changes, skipping checks")
        return 0

    if needs_compile_gates(staged):
        print("→ pre-commit: compile-affecting changes, running full precommit set...")
        if run_recipe("precommit") != 0:
            return reject(
                "✗ static checks failed; commit blocked",
                "  fix formatting with 'just fmt-fix'; fix and recommit"
                " — do not bypass with --no-verify",
            )
        return 0

    print("→ pre-commit: no compile-affecting changes, running text gates...")
    if run_recipe("text-gates") != 0:
        return reject(
            "✗ text gates failed; commit blocked (see above)",
            "  suspected secret false positive: allow it with a trailing secrets:allow"
            " (rules in scripts/hooks/check_secrets.py); fix and recommit"
            " — do not bypass with --no-verify",
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
