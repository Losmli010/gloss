#!/usr/bin/env python3
"""提交前钩子：提交前的静态检查，含格式化、静态检查（Clippy）与硬编码密钥扫描等，
全套清单见配方清单里的提交前检查配方。
需要本地全量验证时手动运行根配方的全量检查配方（格式化、静态检查与测试）。
"""

import os
import shutil
import subprocess
import sys


def run_recipe(recipe):
    return subprocess.run(["just", recipe]).returncode


def reject(message, hint):
    print("", file=sys.stderr)
    print(message, file=sys.stderr)
    print(hint, file=sys.stderr)
    return 1


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if root.returncode != 0:
        print("✗ not inside a git repository; cannot run pre-commit checks", file=sys.stderr)
        return 1
    # 定位项目根目录（钩子可能从任何子目录触发）
    os.chdir(root.stdout.strip())

    cargo_bin = os.path.expanduser("~/.cargo/bin")
    os.environ["PATH"] = cargo_bin + os.pathsep + os.environ.get("PATH", "")

    if not shutil.which("just"):
        print("✗ just not found; cannot run pre-commit checks", file=sys.stderr)
        print("  install: brew install just", file=sys.stderr)
        return 1

    staged = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    ).stdout.split()
    if not staged:
        print("→ pre-commit: no staged changes, skipping checks")
        return 0

    # 有本语言（Rust）源码变更才跑格式化与静态检查（全量经提交前检查配方）；密钥扫描、
    # 指令文档引用校验与约束检查语言无关，任何提交都跑。
    if not any(f.endswith(".rs") for f in staged):
        print(
            "→ pre-commit: no .rs changes, skipping fmt/clippy;"
            " running secrets / doc references / constraints..."
        )
        gates = [
            ("secrets", "✗ suspected hardcoded secret detected; commit blocked",
             "  false positive: allow it with a trailing secrets:allow"
             " (rules in scripts/hooks/check_secrets.py)"),
            ("agents-doc",
             "✗ AGENTS.md references recipes/paths that do not exist; commit blocked (see above)",
             ""),
            ("test-bdd", "✗ bdd.md and test sources disagree; commit blocked (see above)", ""),
            ("constraints", "✗ non-negotiable constraints violated; commit blocked (see above)", ""),
            ("i18n", "✗ ui copy must live in the i18n catalog; commit blocked (see above)", ""),
        ]
        for recipe, message, hint in gates:
            if run_recipe(recipe) != 0:
                return reject(message, hint)
        return 0

    print(
        "→ pre-commit: running static checks (just precommit full set: constraints"
        " + doc references + BDD inventory + i18n catalog + comment discipline"
        " + fmt + clippy + secrets)..."
    )
    if run_recipe("precommit") != 0:
        return reject(
            "✗ static checks failed; commit blocked",
            "  fix formatting with 'just fmt-fix'; fix and recommit"
            " — do not bypass with --no-verify",
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
