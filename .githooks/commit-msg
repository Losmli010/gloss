#!/usr/bin/env python3
# commit-msg 钩子：提交信息落定后、提交完成前校验 Conventional Commits 规范
# （type(scope): subject、标题 ≤81 字节），把 CI 的 message 返工挡在本地。
# 校验逻辑与 CI 的 Commit message check 共用 check_commit_msg.py 单点。

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "scripts", "hooks"))

import check_commit_msg  # noqa: E402 —— 路径引导先于导入


def main():
    # merge commit 的自动消息（Merge branch ...）不在规范内，跳过——与 CI 校验
    # 的 --no-merges 口径一致；squash 后的正式提交仍会走 PR 标题校验。
    if subprocess.run(["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"],
                      capture_output=True).returncode == 0:
        return 0
    if len(sys.argv) < 2:
        print("✗ commit-msg 钩子缺少消息文件参数", file=sys.stderr)
        return 1
    with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
        problem = check_commit_msg.run(fh.read())
    if problem:
        print("", file=sys.stderr)
        print("✗ commit message 不符合规范，已阻止提交（CI 同款校验，修消息不返工）",
              file=sys.stderr)
        print(problem, file=sys.stderr)
        print("  补救：git commit --amend 后重提；规范说明见 scripts/hooks/check_commit_msg.py",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
