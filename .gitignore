# 构建工具（Cargo）自动生成：编译产物与可执行文件
debug
target

# 本语言（Rust）格式化工具生成的备份文件
**/*.rs.bk

# 系统（Windows）编译器生成的调试信息文件
*.pdb

# 变异测试工具的产物：变异测试数据
**/mutants.out*/

# 本地决策记录不进仓库；测试行为清单例外，随仓库跟踪
docs/*
!docs/tests/

# 脚本语言（Python）工具的本地缓存，门禁单测与格式化工具的运行产物
__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
# 编码助手（ZCode）共享配置与钩子随仓库跟踪；本地会话状态不进仓库
.zcode/*
!.zcode/config.json
!.zcode/hooks/
.zcodeignore

# 快照对比的临时产物
**/tests/snapshots/**/*.diff.png
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.old.png

# 会话工具（WorkBuddy）目录（本地状态，不进仓库）
.workbuddy/

# 站点部署注入产物：最新版二进制与更新清单由持续集成生成，不进仓库
web/manifest.json
web/latest/*
!web/latest/.gitkeep
